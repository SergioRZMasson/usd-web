{
  "name": "usd-web-gltf-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser demo: drop a USD file in, see it rendered in Babylon.js.",
  "scripts": {
    "build": "webpack --config ./webpack.config.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "webpack --config ./webpack.config.mjs --watch"
  },
  "dependencies": {
    "@babylonjs/core": "9.19.1",
    "@babylonjs/loaders": "9.19.1",
    "@openusd-wasm/babylon": "file:../babylon",
    "usd-web-gltf": "file:../js"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^12.0.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  }
}
