# Native build output. The `wasm` CMake preset writes to build/wasm; vcpkg installs its
# compiled dependencies (OpenUSD, tbb, zlib) under build/vcpkg_installed.
build/
build-*/

# vcpkg manifest install tree (if one is ever produced outside build/)
vcpkg_installed/

# Dependencies
node_modules/

# npm package build output (regenerated from the native build)
js/dist/

# NOTE: docs/ is intentionally NOT ignored. It holds the built demo and the WebAssembly
# artifacts, and is published by GitHub Pages so partners can try the converter without
# building anything. It is named `docs` because branch-based Pages can only serve `/` or
# `/docs`.

# Loose native artifacts
*.o
*.a

# Test output
test/*.glb
demo/babylon-loader-test/public/
.playwright-cli/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
