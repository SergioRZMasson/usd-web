{
  "name": "@openusd-wasm/babylon",
  "version": "0.1.0",
  "description": "Asynchronously load USD assets into Babylon.js through a direct C++ command-buffer bridge.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": {
      "default": "./dist/wasm/openusd-babylon.wasm"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-wasm.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@babylonjs/core": ">=9.0.0"
  },
  "devDependencies": {
    "@babylonjs/core": "9.19.1",
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
